{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Link locations",
  "type": "object",
  "required": ["locations"],
  "additionalProperties": false,
  "properties": {
    "locations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "name": { "type": "string" }
        }
      }
    }
  }
}
