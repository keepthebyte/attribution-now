{
  "name": "attribution-now",
  "private": true,
  "version": "0.1.0",
  "description": "attribution.now: helping AI labs improve attribution on outbound links (HTTP referrer + UTM).",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "validate": "node build/validate.mjs",
    "render": "node build/render.mjs",
    "build": "npm run validate && npm run render",
    "test": "node --test \"test/*.test.mjs\"",
    "export-hits": "node worker/scripts/export-hits.mjs",
    "lint:js": "eslint .",
    "lint:css": "stylelint \"blocks/**/*.css\" \"styles/*.css\"",
    "lint": "npm run lint:js && npm run lint:css",
    "lint:fix": "npm run lint:js -- --fix && npm run lint:css -- --fix",
    "preview": "node build/preview.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/keepthebyte/attribution-now.git"
  },
  "license": "Apache-2.0",
  "devDependencies": {
    "@babel/eslint-parser": "7.29.9",
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "cheerio": "^1.2.0",
    "eslint": "8.57.1",
    "eslint-config-airbnb-base": "15.0.0",
    "eslint-plugin-import": "2.32.0",
    "marked": "15.0.12",
    "pixelmatch": "^8.0.0",
    "playwright": "^1.64.1",
    "pngjs": "^7.0.0",
    "stylelint": "17.16.0",
    "stylelint-config-standard": "40.0.0",
    "yaml": "2.8.1"
  }
}
